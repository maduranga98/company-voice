rules_version = '2';

// Firebase Storage Security Rules
// Authorization comes from the custom claims minted by the login Cloud Function
// (request.auth.token.role and request.auth.token.companyId). Storage rules cannot read
// Firestore, so there is no session lookup. Staff only: admin/HR of the company, and super_admin.
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    // Signed-in staff member (role claim present; anonymous Firebase users have none)
    function isAuthenticated() {
      return request.auth != null
        && request.auth.token.get('role', null) in ['super_admin', 'company_admin', 'hr'];
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }

    // Staff of this company (or super_admin)
    function inCompany(companyId) {
      return isSuperAdmin()
        || (isAuthenticated() && request.auth.token.get('companyId', null) == companyId);
    }

    function isCompanyAdminOf(companyId) {
      return isSuperAdmin()
        || (isAuthenticated()
            && request.auth.token.role == 'company_admin'
            && request.auth.token.get('companyId', null) == companyId);
    }

    // Validate file size (in MB)
    function isValidFileSize(maxSizeMB) {
      return request.resource.size <= maxSizeMB * 1024 * 1024;
    }

    // Validate image file types
    function isValidImageType() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.contentType in ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
    }

    // Validate document file types
    function isValidDocumentType() {
      return request.resource.contentType in [
        'application/pdf',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.ms-excel',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'text/plain',
        'text/csv'
      ];
    }

    // ============================================
    // USER PROFILE IMAGES
    // Path: companies/{companyId}/users/{userId}/profile/{fileName}
    // ============================================
    match /companies/{companyId}/users/{userId}/profile/{fileName} {
      allow read: if inCompany(companyId);
      allow write: if inCompany(companyId) && (request.auth.uid == userId || isCompanyAdminOf(companyId)) && isValidImageType() && isValidFileSize(5);
      allow delete: if inCompany(companyId) && (request.auth.uid == userId || isCompanyAdminOf(companyId));
    }

    // ============================================
    // COMPANY LOGOS
    // Path: companies/{companyId}/logo/{fileName}
    // ============================================
    match /companies/{companyId}/logo/{fileName} {
      allow read: if inCompany(companyId);
      allow write: if isCompanyAdminOf(companyId) && isValidImageType() && isValidFileSize(5);
      allow delete: if isCompanyAdminOf(companyId);
    }

    // ============================================
    // POST ATTACHMENTS
    // Path: companies/{companyId}/posts/{postId}/attachments/{fileName}
    // ============================================
    match /companies/{companyId}/posts/{postId}/attachments/{fileName} {
      allow read: if inCompany(companyId);
      allow write: if inCompany(companyId) && (isValidImageType() || isValidDocumentType()) && isValidFileSize(50);
      allow delete: if inCompany(companyId);
    }

    // ============================================
    // PUBLIC REPORT UPLOADS (no login)
    // Path: public-reports/pending/{uploadId}/{fileName}
    // Create only: no read, update or delete from clients. The submitPublicReport
    // function moves validated files into the case folder; a scheduled job
    // removes orphans. Enable App Check enforcement for Storage in the console.
    // ============================================
    match /public-reports/pending/{uploadId}/{fileName} {
      allow create: if uploadId.matches('[A-Za-z0-9_-]{16,64}')
                    && request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType in [
                      'image/jpeg', 'image/png', 'image/webp',
                      'application/pdf', 'audio/webm', 'audio/mp4'
                    ];
      allow read, update, delete: if false;
    }

    // ============================================
    // PUBLIC REPORT CASE ATTACHMENTS
    // Path: companies/{companyId}/cases/{postId}/{fileName}
    // Written by Cloud Functions only. Read: staff of the company. HR can read the files of
    // involvesHR cases only if it knows the path, which sits in a post it cannot read.
    // ============================================
    match /companies/{companyId}/cases/{postId}/{fileName} {
      allow read: if inCompany(companyId);
      allow write: if false;
    }

    // ============================================
    // DISCUSSION ATTACHMENTS
    // Path: companies/{companyId}/discussions/{discussionId}/attachments/{fileName}
    // ============================================
    match /companies/{companyId}/discussions/{discussionId}/attachments/{fileName} {
      allow read: if inCompany(companyId);
      allow write: if inCompany(companyId) && (isValidImageType() || isValidDocumentType()) && isValidFileSize(50);
      allow delete: if inCompany(companyId);
    }

    // ============================================
    // COMPANY DOCUMENTS (General)
    // Path: companies/{companyId}/documents/{category}/{fileName}
    // ============================================
    match /companies/{companyId}/documents/{category}/{fileName} {
      allow read: if inCompany(companyId);
      allow write: if inCompany(companyId) && isValidDocumentType() && isValidFileSize(50);
      allow delete: if inCompany(companyId);
    }

    // ============================================
    // TEMPORARY UPLOADS
    // Path: temp/{userId}/{fileName}
    // ============================================
    match /temp/{userId}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId && (isValidImageType() || isValidDocumentType()) && isValidFileSize(50);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================
    // ADMIN UPLOADS
    // Path: admin/{category}/{fileName}
    // ============================================
    match /admin/{category}/{fileName} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin() && (isValidImageType() || isValidDocumentType()) && isValidFileSize(50);
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // ANALYTICS EXPORTS
    // Path: companies/{companyId}/exports/{exportType}/{fileName}
    // ============================================
    match /companies/{companyId}/exports/{exportType}/{fileName} {
      allow read: if inCompany(companyId);
      allow write: if inCompany(companyId);
      allow delete: if inCompany(companyId);
    }

    // ============================================
    // POST UPLOADS (Alternative Path)
    // Path: posts/{companyId}/{fileName}
    // ============================================
    match /posts/{companyId}/{fileName} {
      allow read: if inCompany(companyId);
      allow write: if inCompany(companyId) && (isValidImageType() || isValidDocumentType()) && isValidFileSize(50);
      allow delete: if inCompany(companyId);
    }

    // ============================================
    // POLICY FILES
    // Path: policies/{companyId}/{policyId}/{fileName}
    // ============================================
    match /policies/{companyId}/{policyId}/{fileName} {
      allow read: if inCompany(companyId);
      allow write: if inCompany(companyId)
                   && request.resource.contentType == 'application/pdf'
                   && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if inCompany(companyId);
    }

    // ============================================
    // VENDOR EVIDENCE UPLOADS
    // Path: vendorEvidence/{companyId}/{reportId}/{fileName}
    // ============================================
    match /vendorEvidence/{companyId}/{reportId}/{fileName} {
      allow read: if inCompany(companyId);
      allow write: if inCompany(companyId)
                   && (request.resource.contentType.matches('image/.*') ||
                       request.resource.contentType == 'application/pdf')
                   && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if false;
    }

    // ============================================
    // LEGAL EVIDENCE UPLOADS
    // Path: legal-evidence/{companyId}/{requestId}/{fileName}
    // ============================================
    match /legal-evidence/{companyId}/{requestId}/{fileName} {
      allow read: if inCompany(companyId);
      allow write: if inCompany(companyId);
      allow delete: if inCompany(companyId);
    }

    // ============================================
    // DENY ALL OTHER PATHS
    // ============================================
    // Billing document paths and any other unlisted paths are denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
