# ============================================
# COMPANY VOICE PLATFORM - ENVIRONMENT VARIABLES
# ============================================

# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================
# FIREBASE CONFIGURATION
# ============================================

# Your Firebase project credentials
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Analytics - Measurement ID
# Get this from Firebase Console > Project Settings > General > Your apps > Web app
# This enables Google Analytics for Firebase
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase App Check - reCAPTCHA v3 Site Key
# Get this from Firebase Console > App Check > reCAPTCHA v3
# Steps to setup:
# 1. Go to Firebase Console > App Check
# 2. Register your web app with reCAPTCHA v3
# 3. Get the site key from Google reCAPTCHA Admin Console (https://www.google.com/recaptcha/admin)
# 4. Add the site key here
# Note: Leave empty to disable App Check (not recommended for production)
# DEPRECATED: no longer read. App Check now uses VITE_APPCHECK_SITE_KEY (see PUBLIC REPORT LINE below).
VITE_FIREBASE_APP_CHECK_KEY=your_recaptcha_v3_site_key_here

# ============================================
# STRIPE BILLING CONFIGURATION
# ============================================

# Stripe publishable key for frontend payment processing
# Get these from: https://dashboard.stripe.com/test/apikeys
# Use test keys (pk_test_...) for development/testing
# Use live keys (pk_live_...) for production
# NOTE: Secret keys (sk_...) should ONLY be set in Firebase Functions via Secret Manager
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ============================================
# ERROR TRACKING - SENTRY
# ============================================

# Sentry DSN for error tracking and monitoring
# Get this from: https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
# Leave empty to disable error tracking in development
# Format: https://[key]@[organization].ingest.sentry.io/[project-id]
VITE_SENTRY_DSN=

# Environment name for Sentry (development, staging, production)
# This helps filter errors by environment in Sentry dashboard
VITE_ENVIRONMENT=development

# ============================================
# SECURITY & ENCRYPTION
# ============================================

# Secret key for encrypting anonymous author IDs
# IMPORTANT: Generate a strong, random key for production
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This key MUST be kept secret and should never be committed to version control
VITE_ANONYMOUS_SECRET=your_very_long_random_secret_key_here

# ============================================
# PUBLIC REPORT LINE (no-login reporting at /r/<slug>)
# ============================================

# Public origin of the app. Report links and QR codes are built as
# ${VITE_PUBLIC_APP_URL}/r/<reportSlug>. Falls back to the current origin when empty.
VITE_PUBLIC_APP_URL=https://portal.voxwel.com

# Cloudflare Turnstile site key (public). Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# and add the portal domain to its allowed domains. The secret key is a Functions secret, never put it here.
# In development, leaving this empty uses Cloudflare's always-pass test key.
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Firebase App Check (reCAPTCHA v3) site key. The public report callables enforce App Check,
# so reporting and the QR page do not work without it. Register the web app in
# Firebase Console > App Check, then paste the reCAPTCHA v3 site key here.
VITE_APPCHECK_SITE_KEY=your_recaptcha_v3_site_key_here

# Development only: App Check debug token registered in Firebase Console > App Check > Manage debug tokens.
# Leave empty to let the SDK print a fresh token to the browser console.
VITE_APPCHECK_DEBUG_TOKEN=

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Environment (development, staging, production)
VITE_ENV=development

# Point the app at the local Firebase emulators (auth, firestore, storage, functions)
VITE_USE_EMULATORS=false

# Enable debug mode (shows additional logging)
VITE_DEBUG=false

# ============================================
# RATE LIMITING
# ============================================

# Maximum posts per hour per user (handled in postManagementService.js)
# Note: This is configured in code, not as env variable currently
# Default: 10 posts per hour

# ============================================
# NOTES FOR DEPLOYMENT
# ============================================

# 1. Generate a secure VITE_ANONYMOUS_SECRET:
#    - Use a cryptographically secure random generator
#    - Minimum 32 characters recommended
#    - Never use the example value above
#
# 2. Keep your .env file secure:
#    - Add .env to .gitignore (should already be there)
#    - Use environment variables in production (Vercel, Netlify, etc.)
#    - Rotate secrets regularly
#
# 3. Firebase Security:
#    - Deploy firestore.rules to Firebase
#    - Set up Firebase Authentication properly
#    - Enable App Check for additional security
#
# 4. For production deployment:
#    - Set NODE_ENV=production
#    - Enable HTTPS only
#    - Configure CORS properly
#    - Set up monitoring and logging
